# ============================================================================
# OUTREACH-OS ENVIRONMENT CONFIGURATION (.env.local)
# ============================================================================

# 1. Supabase PostgreSQL Database (Optional locally: falls back to .data/local-db.json if blank)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 2. Gmail API OAuth2 Credentials (For Primary Inbox RFC 2822 Sending & Thread Reply Polling)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GOOGLE_REDIRECT_URI=https://developers.google.com/oauthplayground

# 3. Resend API (Optional alternative transactional email sender)
RESEND_API_KEY=

# 4. Security & Cron Automation
CRON_SECRET=
ADMIN_PASSCODE=

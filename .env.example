# ── Supabase ──────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ── Public URL of this OutreachOS deployment ──────────────
# Used to build the open pixel + click-redirect links inside emails.
# Must be reachable from the internet (e.g. https://outreach-os.vercel.app).
APP_BASE_URL=http://localhost:3000

# ── Gmail API (OAuth2) ────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Either paste a refresh token from the OAuth Playground here, or use
# Settings → "Connect Gmail" to store one in system_settings.
GMAIL_REFRESH_TOKEN=

# ── Resend (optional custom-domain engine) ────────────────
RESEND_API_KEY=
# Verified sender on your Resend domain. Falls back to sender_name/sender_email from Settings.
RESEND_FROM="Suman Debnath <suman@houseofnamus.com>"
# Where replies to Resend mail should land (keep this your Gmail so reply detection works).
RESEND_REPLY_TO=sumandebnath944@gmail.com

# ── Security ──────────────────────────────────────────────
# Bearer token required by /api/cron/process-queue.  Generate: openssl rand -hex 32
CRON_SECRET=
# HMAC key that signs click-redirect URLs (prevents open-redirect abuse).
TRACKING_SECRET=
# HTTP Basic Auth for the dashboard + management API. REQUIRED in production — without it the
# dashboard answers 503. May be left blank only for `npm run dev` on your own machine.
DASHBOARD_USER=suman
DASHBOARD_PASSWORD=

# ── Misc ──────────────────────────────────────────────────
# Timezone that defines "today" for the daily send quota.
OWNER_TIMEZONE=Asia/Kolkata
# Comma-separated origins allowed to POST portfolio telemetry (add the www. variant if you serve one).
PORTFOLIO_ALLOWED_ORIGINS=https://sumandebnath.houseofnamus.com
